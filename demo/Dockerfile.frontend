FROM node:18 AS build

WORKDIR /app

COPY react-ts/package*.json ./
RUN npm install

# Copy production frontend into the image only (host react-ts/ is never written)
COPY react-ts/ ./
# DEMO-only UI overlay (banner, reset, login hint)
COPY demo/overlays/frontend/ ./

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

FROM nginx:alpine
COPY react-ts/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
