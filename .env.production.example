# Copiar a .env en el VPS (no subir secretos al repo)
# cp .env.production.example .env

# Clave JWT — cambiar por una larga y aleatoria
SECRET_KEY=cambia-esta-clave-por-una-segura-y-larga

# Orígenes permitidos (el puerto público del mapping del VPS)
# Si mapeás 10046 -> 8080, usá el 10046 en el navegador:
CORS_ORIGINS=http://69.197.176.243:10046,http://69.197.176.243:8080,http://localhost:8080

# --- Port mapping en el panel del VPS ---
# Public IP: 69.197.176.243
# Agregar: Public Port 10046  ->  Inner Port 8080  (TCP)
# (80 ya está usado por el otro proyecto en 10045 -> 80)
# SSH sigue en 10044
